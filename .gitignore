/analyze.js

# Entorno CAD 3.12 (build123d/OCP) - NO commitear (pesa ~500MB)
.venv-cad/

# Python bytecode (cadlib del skill cad-design)
__pycache__/

# Cache local de documentos de empresa (repo publico — NUNCA commitear)
.sgc-cache/

# cuadros y clips intermedios del skill editar-video (se regeneran)
.video/

# Marcadores de /auditoria-cliente (los exige el gate de _exportAmfeOficial.ts)
.audit-cliente/

# Extractos de documentos de la empresa (alertas, 8D, specs de cliente, SGC, IATF).
# Estuvieron versionados por error hasta 2026-07-29 (828 archivos, 259 MB, publicos).
# Ahora viven en .sgc-cache/empresa-extracted/. NO volver a commitear esta ruta.
docs/empresa-extracted/

# Datos de la empresa — NO commitear (repo publico)
REGISTRO_TIEMPOS_INYECCION.xlsx

# Artefactos de scratch de Claude Code que entraron por una ruta de Windows
# mal formada (el ":" de "C:" se convirtio en parte del nombre). Ver commit 3a917384.
*scratchpad*

# Cache local de mails (Outlook) — DATOS DE LA EMPRESA, el repo es publico
.mail-cache/

# Flujogramas: artefactos de build del generador (tools/flowchart).
# El motor, los datos y el CSS SI se versionan; los PNG y el bundle no.
tools/flowchart/.build/

# Clave del QR de verificacion — NUNCA al repo (es publico)
.qr-secret

# Estado local del rol coordinador (encargos emitidos) — no va al repo
.claude/state/

# Cache local de ordenes de compra (Z:\arb\oc\ocauto\BA) — DATOS DE LA EMPRESA (proveedores,
# precios, codigos), el repo es publico. Lo genera scripts/_oc.py --indexar.
.oc-cache/

# Venv de transcripcion de audio (faster-whisper + modelo, ~2 GB) — no va al repo
.venv-audio/
