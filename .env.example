# Barack Mercosul — Variables de entorno
# Copiar este archivo como .env y completar con los valores reales.
# NUNCA commitear el archivo .env real.

# Supabase — obtener en: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de la API de Anthropic (creditos mensuales del plan Max; NO la usa Claude Code).
# Sale de platform.claude.com > API Keys, en la organizacion vinculada al plan desde claude.ai.
# No se escribe a mano: node scripts/_claude.mjs --pegar-clave (regla .claude/rules/api-claude.md).
ANTHROPIC_API_KEY=
