{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-context.sh lecciones",
            "statusMessage": "Inyectando LECCIONES_APRENDIDAS..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-context.sh compact",
            "statusMessage": "Reinyectando nucleo post-compact..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/file-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/supabase-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/validator-check.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/renumber-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/consumos-entregable-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/cad-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/patrones-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/escritorio-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(execute_sql|apply_migration)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/mcp-write-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/supabase-write-flag.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && EDITED=$(git diff --name-only HEAD 2>/dev/null | grep -E \"\\.(ts|tsx|js|jsx|css|json)$\" | head -5); if [ -n \"$EDITED\" ]; then echo \"Code was edited but no dev server is running. If the change is observable in a browser preview (per <when_to_verify>), call preview_start and follow <verification_workflow>. If not, end your turn without mentioning this check — do not announce that you are skipping.\" >&2; exit 2; fi; exit 0'"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-close-guard.sh"
          }
        ]
      }
    ]
  }
}
